<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>PLG_SYSTEM_STORELINKR</name>
	<author>Hikari Software</author>
	<creationDate>{__DATE__}</creationDate>
	<copyright>(C) 2026 Hikari Software. All rights reserved.</copyright>
	<license>GNU/GPL version 2 or later; see LICENSE.txt</license>
	<licence>GNU/GPL version 2 or later; see LICENSE.txt</licence>
	<authorEmail>dev@hikashop.com</authorEmail>
	<authorUrl>https://www.hikashop.com</authorUrl>
	<version>{__VERSION__}</version>
	<description>PLG_SYSTEM_STORELINKR_XML_DESCRIPTION</description>
	<files>
		<filename plugin="storelinkr">storelinkr.php</filename>
		<folder>core</folder>
		<folder>language</folder>
		<folder>src</folder>
	</files>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="endpoint_note" type="note" label="PLG_SYSTEM_STORELINKR_ENDPOINT" description="PLG_SYSTEM_STORELINKR_ENDPOINT_DESC" />
				<field name="api_key" type="text" default="" label="PLG_SYSTEM_STORELINKR_API_KEY" description="PLG_SYSTEM_STORELINKR_API_KEY_DESC" />
				<field name="api_secret" type="text" default="" label="PLG_SYSTEM_STORELINKR_API_SECRET" description="PLG_SYSTEM_STORELINKR_API_SECRET_DESC" />
				<field name="import_source" type="text" default="storelinkr" label="PLG_SYSTEM_STORELINKR_IMPORT_SOURCE" description="PLG_SYSTEM_STORELINKR_IMPORT_SOURCE_DESC" />
				<field name="default_currency_id" type="number" default="" min="0" label="PLG_SYSTEM_STORELINKR_DEFAULT_CURRENCY" description="PLG_SYSTEM_STORELINKR_DEFAULT_CURRENCY_DESC" />
				<field name="imported_order_status" type="text" default="created" label="PLG_SYSTEM_STORELINKR_ORDER_STATUS" description="PLG_SYSTEM_STORELINKR_ORDER_STATUS_DESC" />
				<field name="publish_new_products" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="PLG_SYSTEM_STORELINKR_PUBLISH_NEW" description="PLG_SYSTEM_STORELINKR_PUBLISH_NEW_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="image_host_allowlist" type="textarea" rows="3" default="" label="PLG_SYSTEM_STORELINKR_IMG_ALLOWLIST" description="PLG_SYSTEM_STORELINKR_IMG_ALLOWLIST_DESC" />
			</fieldset>
		</fields>
	</config>
	<updateservers>
		<server type="extension" name="HikaShop StoreLinkr Connector">https://github.com/hikashop-nicolas/hikashop-storelinkr/releases/latest/download/plg_system_storelinkr.xml</server>
	</updateservers>
</extension>
